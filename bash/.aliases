# Shared bash aliases and small functions

alias ll='ls -lAh --color=auto'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias gs='git status -sb'
alias gl='git log --oneline --graph --decorate -20'
alias grep='grep --color=auto'

# Serve current directory on http://localhost:8000
alias serve='python3 -m http.server 8000'

# Extract any archive: extract file.tar.gz
extract() {
    if [ -z "$1" ] || [ ! -f "$1" ]; then
        echo "usage: extract <archive>"; return 1
    fi
    case "$1" in
        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz)  tar xzf "$1" ;;
        *.tar.xz)  tar xJf "$1" ;;
        *.tar)     tar xf "$1" ;;
        *.tbz2)    tar xjf "$1" ;;
        *.tgz)     tar xzf "$1" ;;
        *.zip)     unzip "$1" ;;
        *.gz)      gunzip "$1" ;;
        *.bz2)     bunzip2 "$1" ;;
        *.7z)      7z x "$1" ;;
        *)         echo "'$1': unknown archive type"; return 1 ;;
    esac
}
